# Encryption key for provider API keys (AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# HMAC secret for session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Server port (default: 3000)
PORT=

# Custom database path (default: ~/.kcgrouter/db/data.sqlite)
DB_PATH=

# Custom home directory (default: ~/.kcgrouter/)
KCGRouter_HOME=
